# ──────────────────────────────────────────────
# App
# ──────────────────────────────────────────────
APP_NAME="eCommerce Laravel"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_TIMEZONE=Europe/Madrid
APP_URL=http://localhost:8080
APP_PORT=8080

# ──────────────────────────────────────────────
# Database (MariaDB)
# ──────────────────────────────────────────────
DB_CONNECTION=mariadb
DB_HOST=db
DB_PORT=3306
DB_DATABASE=ecommerce
DB_USERNAME=ecommerce_user
DB_PASSWORD=ecommerce_pass
DB_ROOT_PASSWORD=root_secret
DB_EXTERNAL_PORT=3307
DB_CHARSET=utf8mb4
DB_COLLATION=utf8mb4_unicode_ci

# ──────────────────────────────────────────────
# Redis
# ──────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ──────────────────────────────────────────────
# Cache / Queue / Session
# ──────────────────────────────────────────────
CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120

# ──────────────────────────────────────────────
# Mail (desarrollo con Mailpit o Mailtrap)
# ──────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS="noreply@ecommerce.test"
MAIL_FROM_NAME="${APP_NAME}"

# ──────────────────────────────────────────────
# Sanctum
# ──────────────────────────────────────────────
SANCTUM_STATEFUL_DOMAINS=localhost:8080

# ──────────────────────────────────────────────
# Payments (Stripe)
# ──────────────────────────────────────────────
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# ──────────────────────────────────────────────
# Logging
# ──────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=daily,structured
LOG_LEVEL=debug

# ──────────────────────────────────────────────
# Monitoreo y Telemetría
# ──────────────────────────────────────────────

# Laravel Telescope (Desarrollo)
TELESCOPE_ENABLED=true
TELESCOPE_PATH=telescope
TELESCOPE_DOMAIN=null
TELESCOPE_ADMIN_EMAIL=admin@pawfectshop.com

# Watchers de Telescope
TELESCOPE_REQUESTS_WATCHER=true
TELESCOPE_JOBS_WATCHER=true
TELESCOPE_COMMANDS_WATCHER=true
TELESCOPE_SCHEDULE_WATCHER=true
TELESCOPE_EVENTS_WATCHER=true
TELESCOPE_VIEWS_WATCHER=false
TELESCOPE_QUERIES_WATCHER=true
TELESCOPE_EXCEPTIONS_WATCHER=true
TELESCOPE_LOGS_WATCHER=true
TELESCOPE_DUMPS_WATCHER=true
TELESCOPE_MAIL_WATCHER=true
TELESCOPE_NOTIFICATIONS_WATCHER=true
TELESCOPE_REDIS_WATCHER=true
TELESCOPE_GATE_WATCHER=true
TELESCOPE_CLIENT_REQUESTS_WATCHER=true
TELESCOPE_MODELS_WATCHER=true

# ──────────────────────────────────────────────
# Filesystem
# ──────────────────────────────────────────────
FILESYSTEM_DISK=local
